# Application Configuration
APP_NAME=KFMS - Knowledge Flow Management System
APP_VERSION=1.0.0
DEBUG=False

# Database - Primary (metadata storage)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kfms_meta
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# LLM Provider ('ollama' or 'groq')
LLM_PROVIDER=ollama

# Ollama Configuration (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=120

# Groq Configuration (Cloud API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768
GROQ_TIMEOUT=60

# Excel Processing
EXCEL_UPLOAD_MAX_SIZE_MB=50
EXCEL_TABLE_TTL_HOURS=24
EXCEL_CLEANUP_INTERVAL_HOURS=1

# Query Execution
QUERY_RESULT_LIMIT=1000
QUERY_TIMEOUT=30

# Security
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=True
